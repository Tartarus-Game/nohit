+    if math.isinf(x):
+        if math.isinf(y):return math.copysign(pi/4. if m<2 else 3.*(pi/4.),y)
+        return math.copysign(0. if m<2 else pi,y)
+    if math.isinf(y):return math.copysign(pi/2.,y)
