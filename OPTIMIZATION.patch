+NOHIT_GAME_DIR=haogesans-export NOHIT_SCRIPTED_HEALING=1 NOHIT_FPS=60 NOHIT_SEARCH_STRATEGY=native python -m tools.native_replay_batch sans_intro sans_bluebone --cpu-budget 8 --processes 4 --out haoge-new
