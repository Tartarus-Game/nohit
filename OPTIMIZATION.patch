+                if(q[6] && overlap(x+gx*.5,y+gy*.5,q[0],q[1],q[0]+q[2],q[1]+q[3]) &&
+                   dy>=q[5] && y+8.<=q[1]+2.){dx=q[4];dy=q[5];y=q[1]-8.05;}
+            }
