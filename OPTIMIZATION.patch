+        if(e[j+1]+5.>y-8.)y=e[j+1]+5.+8.;
+        if(e[j+2]-5.<x+8.)x=e[j+2]-5.-8.;
+        if(e[j+3]-5.<y+8.)y=e[j+3]-5.-8.;
+    }
+}
+static void step(const State& s,int mask,const double* e,const double* p,int np,State& out) {
