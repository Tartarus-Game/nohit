+    if k>60:z=pi/2.+.5*pi_lo;m&=1
+    elif hx>>31 and k< -60:z=0.
+    else:z=_atan(abs(y/x))
+    if m==0:return z
+    if m==1:return -z
+    if m==2:return pi-(z-pi_lo)
+    return (z-pi_lo)-pi
