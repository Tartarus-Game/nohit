+    hx=_high(x);ix=hx&0x7fffffff
+    if ix>=0x44100000:
+        if math.isnan(x):return x+x
+        return math.copysign(_HI[3]+_LO[3],x)
+    if ix<0x3fdc0000:
+        if ix<0x3e400000:return x
+        index=-1
+    else:
+        x=abs(x)
+        if ix<0x3ff30000:
+            if ix<0x3fe60000:index=0;x=(2.*x-1.)/(2.+x)
+            else:index=1;x=(x-1.)/(x+1.)
