+    states=np.zeros((120,11));states[:,:2]=rng.uniform(-15,115,(120,2));states[:,2:4]=rng.uniform(-750,750,(120,2))
+    states[:,4]=rng.integers(0,32,120);states[:,5]=rng.integers(0,2,120);states[:,6:10]=(mode,direction,750.,1.)
