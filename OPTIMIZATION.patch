+            double candidate=start+mx*(double(i)/count);
+            if(solid(candidate,y,dy,dir,e,p,np,0.,0.,true)) {
+                if(slammed){slammed=0.;if(std::abs(dx)>=330. && slamdamage)damage=1.;}
+                if(dx!=0.){dx=0.;x=start+mx*(double(i-1)/count);break;}
+            }
+            x=candidate;
+        }
+    }
+    if(my!=0.) {
