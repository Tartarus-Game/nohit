new file mode 100644
index 0000000..50a0e0b
--- /dev/null
+++ b/generic-engine/godot/addons/nohit/native_baker.gd
@@ -0,0 +1,36 @@
+extends RefCounted
+## Geometry only. Damage semantics and collision filters remain host-owned.
+## No raster/polygon reimplementation: Shape2D.collide calls Godot physics.
+static func capture(object: CollisionObject2D) -> Array:
+	var out: Array = []
+	for owner in object.get_shape_owners():
+		if object.is_shape_owner_disabled(owner):
+			continue
+		var transform: Transform2D = object.global_transform * object.shape_owner_get_transform(owner)
+		for i in object.shape_owner_get_shape_count(owner):
+			out.append({"shape": object.shape_owner_get_shape(owner, i).duplicate(true), "transform": transform})
+	return out
+
+static func overlaps(player: Array, hazards: Array, offset: Vector2 = Vector2.ZERO) -> bool:
+	for p in player:
+		var transform: Transform2D = p.transform
+		transform.origin += offset
+		for h in hazards:
+			if p.shape.collide(transform, h.shape, h.transform):
+				return true
+	return false
+
+static func bake_samples(player: Array, hazards: Array, bounds: Rect2, spacing: float) -> Dictionary:
+	assert(spacing > 0.0 and bounds.size.x > 0.0 and bounds.size.y > 0.0)
+	var columns: int = int(ceil(bounds.size.x / spacing))
+	var rows: int = int(ceil(bounds.size.y / spacing))
+	var bits := PackedByteArray()
+	bits.resize((columns * rows + 7) / 8)
+	bits.fill(0)
+	for y in rows:
+		for x in columns:
+			var i: int = y * columns + x
+			if overlaps(player, hazards, bounds.position + Vector2(x, y) * spacing):
+				bits[i >> 3] |= 1 << (i & 7)
+	return {"columns": columns, "rows": rows, "spacing": spacing, "origin": bounds.position,
+		"bits": bits, "meaning": "native overlap at sample points only; not a continuous free-space certificate"}
diff --git a/generic-engine/godot/addons/nohit/solver.gd b/generic-engine/godot/addons/nohit/solver.gd
new file mode 100644
index 0000000..5c77bd7
--- /dev/null
+++ b/generic-engine/godot/addons/nohit/solver.gd
@@ -0,0 +1,67 @@
+extends RefCounted
+## Bounded search. No route = unknown. Full world state retained per branch.
+func digest(state: Dictionary) -> String:
+	var context := HashingContext.new()
+	context.start(HashingContext.HASH_SHA256)
+	context.update(var_to_bytes(state))
+	return context.finish().hex_encode()
+
+func solve(bridge: Node, width: int, max_ticks: int, seconds: float, delta: float) -> Dictionary:
+	if width < 1 or max_ticks < 1 or seconds <= 0.0 or delta <= 0.0 or not bridge.validate():
+		return {"status": "invalid_adapter"}
+	var start_usec := Time.get_ticks_usec()
+	var initial: Dictionary = bridge.snapshot()
+	var initial_damage: int = bridge.host.damage_count()
+	var records: Array = [{"parent": -1, "action": 0, "digest": digest(initial)}]
+	var frontier: Array = [{"state": initial, "record": 0, "rank": 0.0}]
+	var expanded := 0
+	for tick in max_ticks:
+		var next: Array = []
+		var seen := {}
+		for parent in frontier:
+			bridge.restore(parent.state)
+			for action in bridge.host.actions():
+				if (Time.get_ticks_usec() - start_usec) / 1000000.0 >= seconds:
+					bridge.restore(initial)
+					return {"status": "unknown", "reason": "budget", "ticks": tick, "expanded": expanded}
+				bridge.restore(parent.state)
+				bridge.step(action, delta)
+				expanded += 1
+				if bridge.host.damage_count() != initial_damage:
+					continue
+				var state: Dictionary = bridge.snapshot()
+				# Exact bytes dedup. Never quantize away hidden state or RNG.
+				var key := var_to_bytes(state).hex_encode()
+				if seen.has(key):
+					continue
+				seen[key] = true
+				var record := records.size()
+				records.append({"parent": parent.record, "action": action, "digest": digest(state)})
+				if bridge.host.finished():
+					var route: Array = []
+					var digests: Array = []
+					while record != 0:
+						route.push_front(records[record].action)
+						digests.push_front(records[record].digest)
+						record = records[record].parent
+					bridge.restore(initial)
+					for i in route.size():
+						bridge.step(route[i], delta)
+						if bridge.host.damage_count() != initial_damage or digest(bridge.snapshot()) != digests[i]:
+							bridge.restore(initial)
+							return {"status": "replay_failed", "tick": i}
+					var passed: bool = bridge.host.finished()
+					bridge.restore(initial)
+					return {"status": "verified_adapter_route" if passed else "replay_failed", "route": route,
+						"ticks": route.size(), "expanded": expanded, "elapsed_ms": (Time.get_ticks_usec() - start_usec) / 1000.0,
+						"verification": "same host full-state deterministic replay; independent real-game replay still required"}
+				next.append({"state": state, "record": record, "rank": bridge.host.rank()})
+		if next.is_empty():
+			bridge.restore(initial)
+			return {"status": "unknown", "reason": "frontier_exhausted", "ticks": tick, "expanded": expanded}
+		next.sort_custom(func(a, b): return a.rank < b.rank)
+		if next.size() > width:
+			next.resize(width)
+		frontier = next
+	bridge.restore(initial)
+	return {"status": "unknown", "reason": "horizon", "expanded": expanded}
