+    const bool horizontal=s.v[7]==0. || s.v[7]==2.;
+    const double primary=horizontal?s.v[2]:s.v[3];
+    const double perpendicular=horizontal?s.v[3]:s.v[2];
+    if(std::abs(primary)<330.)return 100;
